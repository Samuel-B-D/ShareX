<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="using:ShareX.AvaloniaUI.Theming"
             xmlns:editorTheming="using:ShareX.ImageEditor.Presentation.Theming"
             x:Class="ShareX.ImageEditor.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theming:ShareXThemeResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <theming:ControlStyles />
        <theming:ToolStyles />
        <editorTheming:EditorStyles />
    </Application.Styles>
</Application>
