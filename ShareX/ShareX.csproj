<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>ShareX_Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Screen capture, file sharing and productivity tool</Description>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <CETCompat>false</CETCompat>
    <!--
      Precompile assemblies when publishing so code does not have to be JIT compiled on first use.
      Without it, the first region capture and other first-time actions are noticeably slower than later ones.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <OptimizationPreference>Speed</OptimizationPreference>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <UseFastDeployment>false</UseFastDeployment>
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- ShareX ships translations and switches CultureInfo at runtime; invariant mode makes GetCultureInfo("fr-FR") throw. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <TrimMode>link</TrimMode>
    <!--
      Trimmed apps default DefaultValueAttribute.IsSupported to false, which turns [DefaultValue(typeof(Color), "Red")]
      into a null value. ShareX applies those defaults through ApplyDefaultPropertyValues (image effects, gradients, ...).
    -->
    <_DefaultValueAttributeSupport>true</_DefaultValueAttributeSupport>
  </PropertyGroup>
  <!--
    Precompile only ShareX assemblies, which CI signs after publishing.
    Recompiling third party assemblies would replace their files and strip the publishers' signatures.
  -->
  <Target Name="ExcludeThirdPartyAssembliesFromReadyToRun"
          BeforeTargets="_PrepareForReadyToRunCompilation"
          DependsOnTargets="_ComputeAssembliesToPostprocessOnPublish">
    <ItemGroup>
      <_ThirdPartyReadyToRunAssembly Include="@(ResolvedFileToPublish)"
                                     Condition="'%(ResolvedFileToPublish.PostprocessAssembly)' == 'true' and !$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('ShareX', StringComparison.OrdinalIgnoreCase))" />
      <PublishReadyToRunExclude Include="@(_ThirdPartyReadyToRunAssembly->'%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!--
      Keep every type and member of the ShareX assemblies when trimming.
      These assemblies are driven by reflection that cannot be statically annotated:
      - Newtonsoft.Json walks the whole settings object graph (ApplicationConfig, TaskSettings, UploadersConfig, ...)
        and resolves image effects by type name (TypeNameHandling.Auto + KnownTypesSerializationBinder).
      - Uploader services, custom uploader functions and image effects are discovered with Assembly.GetTypes().
      - Settings pages are generated from PropertyInfo/TypeDescriptor metadata.
      Framework and third-party assemblies are still trimmed.
    -->
    <TrimmerRootAssembly Include="ShareX" />
    <TrimmerRootAssembly Include="ShareX.Avalonia" />
    <TrimmerRootAssembly Include="ShareX.HelpersLib" />
    <TrimmerRootAssembly Include="ShareX.HistoryLib" />
    <TrimmerRootAssembly Include="ShareX.Icons" />
    <TrimmerRootAssembly Include="ShareX.ImageEditor" />
    <TrimmerRootAssembly Include="ShareX.ImageEffectsLib" />
    <TrimmerRootAssembly Include="ShareX.PhotoEditor" />
    <TrimmerRootAssembly Include="ShareX.ScreenCaptureLib" />
    <TrimmerRootAssembly Include="ShareX.ScreenRecordingLib" />
    <TrimmerRootAssembly Include="ShareX.Tools" />
    <TrimmerRootAssembly Include="ShareX.UploadersLib" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources\Flags\*.svg" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Localization\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShareX.Avalonia\ShareX.Avalonia.csproj" />
    <ProjectReference Include="..\ShareX.Tools\ShareX.Tools.csproj" />
    <ProjectReference Include="..\ShareX.HistoryLib\ShareX.HistoryLib.csproj" />
    <ProjectReference Include="..\ShareX.ImageEditor\ShareX.ImageEditor.csproj" />
    <ProjectReference Include="..\ShareX.PhotoEditor\ShareX.PhotoEditor.csproj" />
    <ProjectReference Include="..\ShareX.ImageEffectsLib\ShareX.ImageEffectsLib.csproj" />
    <ProjectReference Include="..\ShareX.NativeMessagingHost\ShareX.NativeMessagingHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\ShareX.ScreenCaptureLib\ShareX.ScreenCaptureLib.csproj" />
    <ProjectReference Include="..\ShareX.ScreenRecordingLib\ShareX.ScreenRecordingLib.csproj" />
    <ProjectReference Include="..\ShareX.HelpersLib\ShareX.HelpersLib.csproj" />
    <ProjectReference Include="..\ShareX.UploadersLib\ShareX.UploadersLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host-manifest-chrome.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="host-manifest-firefox.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ShareX_File_Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>
</Project>
